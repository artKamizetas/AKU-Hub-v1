# Credenciais para scripts/migrar.py (migrações DDL do schema `app`).
#
# COMO USAR:  copie este arquivo para .env e preencha o token.
#     cp .env.example .env
#
# O .env é git-ignored (nunca é commitado). Só o scripts/migrar.py lê este
# arquivo — o app NÃO lê. Por isso o token fica aqui, e NUNCA em
# .streamlit/secrets.toml (que pode ir para o app e ampliaria o raio de dano:
# este token pode DROP TABLE).

# Personal Access Token do Supabase (Account -> Access Tokens). Obrigatório.
SUPABASE_ACCESS_TOKEN=

# Project ref (o "<ref>" de https://<ref>.supabase.co). Opcional: por padrão é
# extraído de [supabase].url do .streamlit/secrets.toml. Só preencha se não usar
# secrets.toml localmente.
# SUPABASE_PROJECT_REF=
