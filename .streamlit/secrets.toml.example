# =============================================================================
# secrets.toml.example — Estrutura das credenciais para o Streamlit Cloud
#
# INSTRUÇÕES:
#   1. Copie este arquivo para .streamlit/secrets.toml
#   2. Preencha cada campo com os valores reais
#   3. NUNCA commite o secrets.toml no repositório (já está no .gitignore)
#
# No Streamlit Cloud: cole o conteúdo em App Settings → Secrets
# =============================================================================

# Supabase (Project Settings → API). SERVICE_KEY ignora RLS — uso server-side.
[supabase]
url = "https://YOUR_PROJECT_REF.supabase.co"
service_key = "YOUR_SERVICE_ROLE_KEY"
# schema opcional (default: public)
schema = "public"
# schema gravável do app (pedidos de compra) — default: app
# requer DDL de docs/sql/001_app_pedidos.sql aplicado e o schema exposto
# na Data API (Settings → API → Exposed schemas)
schema_app = "app"

# -----------------------------------------------------------------------------
# Autenticação do dashboard — login com Google (OIDC nativo do Streamlit)
# -----------------------------------------------------------------------------
# Credenciais do app criado em console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID → Web application. Em "Authorized redirect URIs"
# cadastre EXATAMENTE a(s) URL(s) abaixo, com o sufixo /oauth2callback.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # no Cloud: https://<app>.streamlit.app/oauth2callback
# Assina o cookie de sessão. Fixo: trocar desloga todo mundo.
#   python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "GERE_32_BYTES_ALEATORIOS"

[auth.google]
client_id = "....apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# -----------------------------------------------------------------------------
# Break-glass: estes e-mails entram como admin mesmo com o Supabase fora do ar.
# É a saída de emergência para lockout — e por isso a lista é SOBERANA: tirar
# alguém daqui faz parte de revogar o acesso. Quem administra o dia a dia é a
# tabela app.usuario, editável na aba Usuários de Configurações.
# -----------------------------------------------------------------------------
[acesso]
admins = ["admin@empresa.com"]
